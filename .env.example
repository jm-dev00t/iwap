IWAP_BACKEND_PORT=8080
IWAP_FRONTEND_PORT=3000
IWAP_POSTGRES_PORT=5432

IWAP_DATASOURCE_URL=jdbc:postgresql://postgres:5432/iwap
IWAP_DATASOURCE_USERNAME=iwap
IWAP_DATASOURCE_PASSWORD=iwap

IWAP_AI_PROVIDER=mock
IWAP_INTEGRATION_MODE=mock
IWAP_DEMO_JWT_SECRET=replace-with-demo-secret
IWAP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Keep Spring AI provider autoconfiguration disabled in mock mode.
IWAP_SPRING_AI_CHAT_MODEL=none
IWAP_SPRING_AI_EMBEDDING_MODEL=none
IWAP_SPRING_AI_IMAGE_MODEL=none
IWAP_SPRING_AI_MODERATION_MODEL=none
IWAP_SPRING_AI_AUDIO_SPEECH_MODEL=none
IWAP_SPRING_AI_AUDIO_TRANSCRIPTION_MODEL=none

OPENAI_API_KEY=
NEXT_PUBLIC_IWAP_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_IWAP_WS_URL=http://localhost:8080/ws/workflows
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=#sales-report
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
